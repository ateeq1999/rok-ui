{
  "feature": "auth",
  "events": [
    {
      "name": "SignInSubmitted",
      "calls": "sign_in",
      "concurrency": "droppable",
      "fields": [
        { "name": "email", "type": "String" },
        { "name": "password", "type": "String" }
      ]
    },
    { "name": "SignOutRequested", "calls": "sign_out" },
    { "name": "ProfileRequested", "calls": "me" }
  ],
  "state": {
    "fields": [{ "name": "user", "type": "Option<User>" }]
  },
  "repository": {
    "name": "AuthRepository",
    "methods": [
      {
        "name": "sign_in",
        "args": [
          { "name": "email", "type": "String" },
          { "name": "password", "type": "String" }
        ],
        "returns": "User",
        "session": "sign_in"
      },
      { "name": "sign_out", "session": "sign_out" },
      { "name": "me", "returns": "User" }
    ]
  },
  "provider": {
    "name": "AuthApi",
    "kind": "http",
    "endpoints": [
      {
        "method": "sign_in",
        "verb": "POST",
        "path": "/sessions",
        "body": "SignInDto",
        "response": "SignedInDto",
        "skip_expire": true
      },
      { "method": "sign_out", "verb": "DELETE", "path": "/sessions/current", "response": "()" },
      { "method": "me", "verb": "GET", "path": "/me", "response": "UserDto" }
    ]
  },
  "dtos": [
    {
      "name": "SignInDto",
      "fields": [
        { "name": "email", "type": "String" },
        { "name": "password", "type": "String" }
      ]
    },
    {
      "name": "SignedInDto",
      "fields": [
        { "name": "token", "type": "String" },
        { "name": "user", "type": "UserDto" }
      ]
    },
    {
      "name": "UserDto",
      "fields": [
        { "name": "id", "type": "UserId" },
        { "name": "name", "type": "String" },
        { "name": "email", "type": "String" }
      ]
    }
  ],
  "view": {
    "form": {
      "event": "SignInSubmitted",
      "server_errors": {
        "bad_request_field": "email",
        "unauthorized_field": "password",
        "field_map": { "emailAddress": "email" }
      }
    }
  }
}
