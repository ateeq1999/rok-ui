# The app in crates (see the architecture guide, "Workspace layout"):
#
# - crates/{{name}}-data: models, providers and repositories.
# - crates/{{name}}-<feature>: a feature's business logic. It depends on the data crate and
#   rok-ui-bloc only, so GPUI cannot reach it.
# - crates/{{name}}: views, routes and `app.rs`, the composition root.
#
# `cargo rok-ui generate` writes each file into its crate (rok-ui.toml says the layout).
[workspace]
members = ["crates/*"]
resolver = "2"

[workspace.package]
version = "0.1.0"
edition = "2021"

[workspace.dependencies]
{{rok_ui}}
{{rok_ui_bloc}}
{{rok_ui_build}}
gpui = "0.2.2"
{{name}}-data = { path = "crates/{{name}}-data" }

[workspace.lints.rust]
missing_docs = "warn"

[workspace.lints.clippy]
pedantic = { level = "warn", priority = -1 }
# Event handlers match every event, often with the same body.
match_same_arms = "allow"
